[Unit]
Description=Cipher Discord Bot and dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cipher-bot
EnvironmentFile=/home/ubuntu/cipher-bot/.env
ExecStart=/home/ubuntu/cipher-bot/venv/bin/python /home/ubuntu/cipher-bot/cipher_bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
