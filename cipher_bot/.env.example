# Utilise un DEUXIÈME bot Discord : son token ne doit jamais être celui de onepiece-bot.
DISCORD_TOKEN=

# Application OAuth2 liée au bot Cipher. Ajoute exactement cette URL dans Discord Developer Portal :
# https://cipher.lefleau.online/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_REDIRECT_URI=https://cipher.lefleau.online/callback

# Génère avec : openssl rand -hex 32
FLASK_SECRET_KEY=

# Administrateurs globaux Cipher (IDs Discord séparés par des virgules).
CIPHER_OWNER_IDS=
# Utilisateurs supplémentaires autorisés à lancer la restructuration.
CIPHER_ALLOWED_USER_IDS=

# Le tableau est exposé uniquement à Nginx, jamais directement sur Internet.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8091
